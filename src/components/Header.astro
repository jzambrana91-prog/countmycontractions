---
import { navLinks } from "../data/site.js";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function current(href) {
  if (href === "/") return pathname === "/";
  return pathname === href;
}
---

<a class="skip" href="#content">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <div class="header-bar">
      <a class="brand" href="/">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="10" fill="currentColor" opacity="0.15"></rect>
          <circle cx="16" cy="16" r="8" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
          <circle cx="16" cy="16" r="2.2" fill="currentColor"></circle>
          <path d="M16 8.2 V11.4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
        </svg>
        <span>Count My Contractions</span>
      </a>
      <div class="header-tools">
        <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false">
          Light mode
        </button>
        <button
          class="nav-toggle"
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="site-nav"
        >
          Menu
        </button>
      </div>
    </div>
    <nav id="site-nav" class="site-nav" data-nav data-open="false" aria-label="Primary">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={current(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
