---
import { contactEmail, guides, trust } from "../data/site.js";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <strong>Count My Contractions</strong>
      <p class="footer-note">
        A free contraction timer and counter. The log stays in this browser. Timing aid, not medical advice.
      </p>
      <p class="footer-note">
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </p>
    </div>
    <div>
      <h2 class="footer-note">Guides</h2>
      <ul class="footer-links">
        <li><a href="/">Contraction timer</a></li>
        {guides.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="footer-note">About this site</h2>
      <ul class="footer-links">
        {trust.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
